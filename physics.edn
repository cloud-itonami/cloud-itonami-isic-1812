;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": robots assist plate-making/proofing and operate
;; the cutting/folding/binding line of a print-finishing shop (ISIC 1812).
;; Their physical work: lifting paper lifts (reams) into the guillotine,
;; moving pallets of printed sheets from the press to the bindery, and
;; holding hot-melt glue at application temperature in the perfect binder.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-1812"
 :cases
 [{:id :ream-to-guillotine
   :kind :manipulator
   :procedure "arm lifts a jogged lift of printed sheets from the delivery pile onto the guillotine table"
   :params {:l1-m 0.60 :l2-m 0.50 :m1-kg 6.0 :m2-kg 4.0
            :from [0.70 0.05] :to [0.30 0.60] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 8.0 12.0 16.0]}
   :quantity :peak-tau1-nm
   :limit {:max 250.0 :basis "estimate: continuous shoulder torque of a ~20 kg-payload industrial arm class"}
   :boundary {:lo 0.5 :hi 60.0}}
  {:id :sheet-pallet-to-bindery
   :kind :transport
   :procedure "pallet AMR carries a 1.4 m-high-CoG pallet of printed sheets from the press delivery to the folding/binding line; sweep = how hard it brakes"
   :params {:mass-kg 300.0 :payload-kg 600.0 :distance-m 40.0 :v-max-mps 1.0 :a-max-mps2 0.4
            :brake-decel-mps2 0.8 :drive-force-n 1500.0 :crr 0.015
            :cog-height-m 0.30 :payload-cog-height-m 1.4 :support-half-length-m 0.50 :max-time-s 1200.0}
   :sweep {:param :brake-decel-mps2 :values [0.8 1.5 2.5 3.5 4.5]}
   :quantity :min-tipover-margin
   :limit {:min 0.3 :basis "estimate: keep 30 % of the static restoring moment in reserve for floor joints and a stack that has shifted"}
   :boundary {:lo 0.5 :hi 6.0}}
  {:id :hot-melt-binder-pot
   :kind :thermal
   :procedure "hot-melt glue in the perfect-binder pot heats from cold start (heater wall 200 C, lidded free surface) until the glue surface reaches 150 C application temperature"
   :params {:thickness-m 0.02 :conductivity-w-mk 0.2 :density-kg-m3 950.0 :specific-heat-j-kgk 2000.0
            :t0-c 20.0 :t-hot-c 200.0 :front-fixed? true :h-back-w-m2k 3.0
            :threshold-c 150.0 :duration-s 7200.0 :nodes 15}
   :sweep {:param :thickness-m :values [0.01 0.015 0.02 0.03 0.04]}
   :quantity :time-to-threshold-s
   :limit {:max 2700.0 :basis "estimate: warm-up must fit inside a 45-minute make-ready before the first binding run"}
   :boundary {:lo 0.005 :hi 0.08}}]}
